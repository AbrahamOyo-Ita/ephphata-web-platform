# EPHAPHATA — environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development, or set these in your host's
# environment panel (Vercel - Project - Settings - Environment Variables).
#
# Nothing here is required to RUN the app: every integration degrades to an
# honest "not configured" state rather than pretending to work. Values marked
# REQUIRED FOR PRODUCTION must be set before a live event.

# ─── Core ───────────────────────────────────────────────────────────────────

# Public origin, used for canonical URLs, OG tags, sitemap and QR links.
# REQUIRED FOR PRODUCTION
NEXT_PUBLIC_SITE_URL=https://ephaphata.com

# Session token pepper. Generate with: openssl rand -base64 48
# REQUIRED FOR PRODUCTION — a development fallback is used when unset, which is
# NOT safe for production.
SESSION_SECRET=

# Salt for hashing IP addresses in the audit log (never stores raw IPs).
# Generate with: openssl rand -hex 16
IP_HASH_SALT=

# ─── Database ───────────────────────────────────────────────────────────────

# Local/demo runtime: path to the SQLite file. Leave unset to use data/ephaphata.db
# DATABASE_PATH=./data/ephaphata.db

# Production: PostgreSQL connection string (Supabase, Neon, RDS).
# When set, the Postgres schema in migrations/postgres/ is the source of truth.
# DATABASE_URL=

# ─── First-run admin account ────────────────────────────────────────────────
# Read by `npm run setup` (scripts/bootstrap-admin.mjs) to create ONE real
# super-admin on a fresh database. Never seeded automatically - run it yourself.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ─── Demo mode ──────────────────────────────────────────────────────────────

# Shows the "Demonstration dataset" banner and the seeded test accounts on the
# login screen. SET TO false BEFORE YOU PUBLISH.
DEMO_MODE=true

# ─── Email (optional) ───────────────────────────────────────────────────────
# Without these, registration confirmations are recorded as `not_configured`
# and the UI says so plainly. No email is silently dropped or faked.

RESEND_API_KEY=
EMAIL_FROM="Ephphata <hello@ephaphata.com>"

# ─── WhatsApp (optional) ────────────────────────────────────────────────────
# Without these, WhatsApp campaigns are disabled in the composer.

WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_SENDER=

# ─── Test harness (optional) ────────────────────────────────────────────────
# BASE_URL=http://localhost:3000
